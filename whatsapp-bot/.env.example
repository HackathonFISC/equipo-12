PORT=3000
WHATSAPP_TOKEN=your-whatsapp-token
PHONE_NUMBER_ID=your-phone-number-id
# Si PHONE_NUMBER_ID está vacío, el proceso también acepta WHATSAPP_PHONE_NUMBER_ID.
WHATSAPP_VERIFY_TOKEN=your-verify-token
# Opcional. Si está presente, POST /webhook exige X-Hub-Signature-256.
WHATSAPP_APP_SECRET=
# La integración de Python de este repo usa v21.0. Cámbiala si Meta publica otra estable.
WHATSAPP_GRAPH_VERSION=v21.0
